# CurioAI Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file

# =============================================
# APPLICATION
# =============================================
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# =============================================
# DATABASE (PostgreSQL via Docker Compose)
# =============================================
POSTGRES_USER=curio
POSTGRES_PASSWORD=curio_dev_password
POSTGRES_DB=curio_ai
DATABASE_URL=postgresql+asyncpg://curio:curio_dev_password@localhost:5432/curio_ai

# =============================================
# REDIS (cache, session, rate limiting)
# =============================================
REDIS_URL=redis://localhost:6379/0

# =============================================
# QDRANT (vector database)
# =============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# =============================================
# OBJECT STORAGE (S3-compatible / MinIO)
# =============================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=curio-documents

# =============================================
# AUTHENTICATION (JWT)
# =============================================
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================
# LLM PROVIDER
# Options: openai, anthropic, gemini, groq, openrouter, custom
# For free tier: use gemini or groq
# For custom: set LLM_PROVIDER=custom and LLM_BASE_URL
# =============================================
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# =============================================
# EMBEDDING PROVIDER
# Options: openai, gemini, local, custom
# For local: uses sentence-transformers (no API key needed)
# =============================================
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=

# =============================================
# RAG CONFIGURATION
# =============================================
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# =============================================
# FRONTEND (Next.js)
# =============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
